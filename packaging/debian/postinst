#!/bin/sh
# lustless maintainer script — postinst (CONTRACTS §4, §11, §15).
#
# Thin caller: all configure logic lives in the payload helper
# /usr/lib/lustless/lustless-maintainer (PACKAGING-MATRIX §3 — one source
# for deb/rpm/pkg/apk scriptlets). Files are unpacked before postinst runs.
set -e

case "${1:-}" in
    configure)
        /usr/lib/lustless/lustless-maintainer configure "${2:-unknown}"
        ;;
    abort-upgrade|abort-install|failed-upgrade)
        ;;
    *)
        echo "postinst called with unknown argument '${1:-}'" >&2
        exit 1
        ;;
esac

exit 0
