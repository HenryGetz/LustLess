#!/bin/sh
# lustless maintainer script — prerm (CONTRACTS §11 uninstall order).
#
# Thin caller: teardown lives in the payload helper
# /usr/lib/lustless/lustless-maintainer (PACKAGING-MATRIX §3). prerm runs
# BEFORE payload files are removed, so the helper is always present here.
# remove / deconfigure / upgrade all run the full teardown (bounded flush,
# stop, DNS restore from backup, browser policy removal/restore); the
# subsequent configure (upgrade) re-applies everything.
set -e

case "${1:-}" in
    remove|deconfigure|upgrade)
        if [ -x /usr/lib/lustless/lustless-maintainer ]; then
            /usr/lib/lustless/lustless-maintainer remove
        fi
        ;;
    failed-upgrade)
        exit 0
        ;;
    *)
        echo "prerm called with unknown argument '${1:-}'" >&2
        exit 1
        ;;
esac

exit 0
